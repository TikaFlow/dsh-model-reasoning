{
  "name": "dsh-model-reasoning",
  "version": "0.7.18",
  "type": "module",
  "description": "DSH 插件：给所有非官方（自定义）提供商的模型自动填充模型信息，包括：推理级别、最大上下文、输出上限与图片模态，数据来自 models.dev。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsdown test/index.ts -d .test-dist --no-config && node .test-dist/index.mjs",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-models": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings-models": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "react": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}